from pathlib import Path
from itertools import combinations

import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
DATA_DIR = ROOT / "data" / "processed"

INPUT_FILE = DATA_DIR / "edge_penalty_candidates.csv"
OUTPUT_FILE = DATA_DIR / "ranked_saferoute_recommendations.csv"
SUMMARY_FILE = DATA_DIR / "ranked_saferoute_summary.csv"

MAX_TIME_OVERHEAD = 0.20
MAX_OVERLAP = 0.70
MAX_RECOMMENDATIONS = 3


def parse_path(value):
    """Parse a pipe-separated sequence of road-network node IDs."""
    if pd.isna(value):
        return []

    return [node for node in str(value).split("|") if node]


def path_edges(path):
    """Represent a route as directed node-to-node edges."""
    return set(zip(path[:-1], path[1:]))


def jaccard_similarity(edges_a, edges_b):
    """Calculate directed-edge Jaccard similarity."""
    union = edges_a | edges_b

    if not union:
        return 1.0

    return len(edges_a & edges_b) / len(union)


def normalize(series):
    """Normalize a numeric series to the interval [0, 1]."""
    minimum = series.min()
    maximum = series.max()

    if maximum == minimum:
        return pd.Series(0.0, index=series.index)

    return (series - minimum) / (maximum - minimum)


def rank_journey(group):
    group = group.copy()

    numeric_columns = [
        "candidate_rank",
        "travel_time_min",
        "distance_km",
        "avg_dynamic_risk",
        "distance_weighted_dynamic_risk",
    ]

    for column in numeric_columns:
        group[column] = pd.to_numeric(
            group[column], errors="coerce"
        )

    group = group.dropna(subset=numeric_columns)

    group = group[
        (group["travel_time_min"] > 0)
        & (group["distance_km"] > 0)
    ].copy()

    if group.empty:
        return pd.DataFrame(), {
            "candidate_count": 0,
            "eligible_count": 0,
            "recommended_count": 0,
            "fastest_time_min": None,
            "time_limit_min": None,
            "mean_pairwise_overlap_percent": None,
            "status": "NO_VALID_CANDIDATES",
        }

    if "node_path" not in group.columns:
        raise ValueError(
            "Input CSV has no 'node_path' column. "
            "Rerun scripts/37_test_edge_penalty_routing.py "
            "to generate candidate paths."
        )

    group = group.reset_index(drop=True)

    # Build route edge sets and reject candidates with missing paths.
    group["_path"] = group["node_path"].apply(parse_path)
    group["_edges"] = group["_path"].apply(path_edges)

    group = group[
        group["_path"].apply(lambda p: len(p) >= 2)
    ].copy().reset_index(drop=True)

    if group.empty:
        return pd.DataFrame(), {
            "candidate_count": 0,
            "eligible_count": 0,
            "recommended_count": 0,
            "fastest_time_min": None,
            "time_limit_min": None,
            "mean_pairwise_overlap_percent": None,
            "status": "NO_VALID_PATHS",
        }

    fastest_time = group["travel_time_min"].min()
    time_limit = fastest_time * (1 + MAX_TIME_OVERHEAD)

    group["time_overhead_percent"] = (
        group["travel_time_min"] / fastest_time - 1
    ) * 100

    # Keep only candidates within the configured time limit.
    eligible = group[
        group["travel_time_min"] <= time_limit
    ].copy().reset_index(drop=True)

    if eligible.empty:
        return pd.DataFrame(), {
            "candidate_count": len(group),
            "eligible_count": 0,
            "recommended_count": 0,
            "fastest_time_min": fastest_time,
            "time_limit_min": time_limit,
            "mean_pairwise_overlap_percent": None,
            "status": "NO_TIME_ELIGIBLE_CANDIDATES",
        }

    # Calculate the balanced score among eligible candidates.
    eligible["normalized_time"] = normalize(
        eligible["travel_time_min"]
    )

    eligible["normalized_risk"] = normalize(
        eligible["distance_weighted_dynamic_risk"]
    )

    eligible["balanced_score"] = (
        0.60 * eligible["normalized_time"]
        + 0.40 * eligible["normalized_risk"]
    )

    # Preferred category winners.
    fastest = eligible.sort_values(
        ["travel_time_min", "candidate_rank"]
    ).iloc[0]

    safest = eligible.sort_values(
        ["distance_weighted_dynamic_risk",
         "travel_time_min",
         "candidate_rank"]
    ).iloc[0]

    balanced = eligible.sort_values(
        ["balanced_score", "candidate_rank"]
    ).iloc[0]

    # Try category winners first, then fill remaining slots with
    # other eligible candidates ordered by balanced score.
    selection_order = [
        ("Fastest", fastest),
        ("Safest", safest),
        ("Balanced", balanced),
    ]

    already_ordered = set()

    for _, candidate in selection_order:
        already_ordered.add(int(candidate["candidate_rank"]))

    alternatives = eligible[
        ~eligible["candidate_rank"].astype(int).isin(already_ordered)
    ].sort_values(
        ["balanced_score", "candidate_rank"]
    )

    selection_order.extend(
        ("Alternative", candidate)
        for _, candidate in alternatives.iterrows()
    )

    selected = []
    assigned_ranks = set()

    for label, candidate in selection_order:
        candidate_rank = int(candidate["candidate_rank"])

        # Do not recommend the same candidate twice.
        if candidate_rank in assigned_ranks:
            continue

        candidate_edges = candidate["_edges"]

        overlaps = [
            jaccard_similarity(candidate_edges, item["_edges"])
            for item in selected
        ]

        max_overlap = max(overlaps, default=0.0)

        # Reject routes that are too similar to any selected route.
        if max_overlap > MAX_OVERLAP:
            continue

        row = candidate.to_dict()
        row["recommendation"] = label
        row["max_overlap_with_selected_percent"] = (
            max_overlap * 100
        )

        selected.append(row)
        assigned_ranks.add(candidate_rank)

        if len(selected) >= MAX_RECOMMENDATIONS:
            break

    # Calculate mean pairwise overlap for the selected routes.
    pairwise_overlaps = []

    for first, second in combinations(selected, 2):
        pairwise_overlaps.append(
            jaccard_similarity(first["_edges"], second["_edges"])
            * 100
        )

    if len(selected) >= MAX_RECOMMENDATIONS:
        status = "PASS"
    elif len(selected) >= 2:
        status = "LIMITED_ALTERNATIVES"
    else:
        status = "INSUFFICIENT_DISTINCT_ROUTES"

    # Remove internal objects from the exported recommendation rows.
    clean_rows = []

    for row in selected:
        row.pop("_path", None)
        row.pop("_edges", None)
        clean_rows.append(row)

    result = pd.DataFrame(clean_rows)

    summary = {
        "candidate_count": len(group),
        "eligible_count": len(eligible),
        "recommended_count": len(result),
        "fastest_time_min": fastest_time,
        "time_limit_min": time_limit,
        "mean_pairwise_overlap_percent": (
            sum(pairwise_overlaps) / len(pairwise_overlaps)
            if pairwise_overlaps else 0.0
        ),
        "status": status,
    }

    return result, summary


def main():
    if not INPUT_FILE.exists():
        raise FileNotFoundError(
            f"Candidate file not found: {INPUT_FILE}\n"
            "Run scripts/37_test_edge_penalty_routing.py first."
        )

    df = pd.read_csv(INPUT_FILE)

    if df.empty:
        raise ValueError("The candidate file contains no routes.")

    required_columns = {
        "test_id",
        "origin",
        "destination",
        "candidate_rank",
        "travel_time_min",
        "distance_km",
        "avg_dynamic_risk",
        "distance_weighted_dynamic_risk",
        "node_path",
    }

    missing = required_columns - set(df.columns)

    if missing:
        raise ValueError(
            f"Input file is missing required columns: {sorted(missing)}"
        )

    recommendation_frames = []
    summary_rows = []

    for test_id, journey in df.groupby("test_id", sort=True):
        ranked, stats = rank_journey(journey)

        if not ranked.empty:
            # ranked already contains test_id from the journey group
            recommendation_frames.append(ranked)

        summary_rows.append({
            "test_id": test_id,
            "origin": journey["origin"].iloc[0],
            "destination": journey["destination"].iloc[0],
            **stats,
        })

    if recommendation_frames:
        recommendations = pd.concat(
            recommendation_frames, ignore_index=True
        )
    else:
        recommendations = pd.DataFrame()

    recommendations.to_csv(OUTPUT_FILE, index=False)

    summary = pd.DataFrame(summary_rows)
    summary.to_csv(SUMMARY_FILE, index=False)

    print("\n========== SAFEROUTE RANKING COMPLETE ==========")
    print(f"Recommendations: {OUTPUT_FILE}")
    print(f"Journey summary:  {SUMMARY_FILE}")

    if not recommendations.empty:
        display_columns = [
            "test_id",
            "origin",
            "destination",
            "candidate_rank",
            "recommendation",
            "travel_time_min",
            "distance_km",
            "distance_weighted_dynamic_risk",
            "max_overlap_with_selected_percent",
        ]

        print("\nRECOMMENDATIONS\n")
        print(
            recommendations[display_columns].to_string(index=False)
        )

    print("\nJOURNEY SUMMARY\n")
    print(summary.to_string(index=False))


if __name__ == "__main__":
    main()
